{
    "$schema": "https://turbo.build/schema.json",
    "globalPassThroughEnv": [
        "WAYLAND_DISPLAY",
        "DISPLAY",
        "XAUTHORITY",
        "DBUS_SESSION_BUS_ADDRESS",
        "XDG_RUNTIME_DIR",
        "XDG_SESSION_TYPE",
        "XDG_CURRENT_DESKTOP",
        "ORIGINAL_XDG_CURRENT_DESKTOP",
        "GH_TOKEN",
        "LOCALAPPDATA"
    ],
    "tasks": {
        "release": {
            "dependsOn": ["^build", "^build"],
            "cache": false
        },
        "dev": {
            "dependsOn": ["^build"],
            "cache": false,
            "persistent": true
        },
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["src/**/*"],
            "outputs": ["dist/**/*", "drizzle/**/*"],
            "outputLogs": "new-only"
        }
    }
}
